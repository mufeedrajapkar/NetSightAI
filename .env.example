# SentinelNet Environment Configuration Example
# Copy this file to .env and configure your shared secret key and central server URL:
#   cp .env.example .env (Linux/macOS) or Copy-Item .env.example .env (PowerShell)

# Shared secret key for authenticating agent ingestion requests (X-API-Key header).
# REQUIRED: The backend server will refuse to start and agents will refuse to push
# to /api/ingest without a configured API key.
SENTINELNET_API_KEY=your-secure-random-secret-key-here

# Central backend server URL (used by capture agents pushing traffic)
SENTINELNET_SERVER_URL=http://127.0.0.1:5001
